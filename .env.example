# Firebase Configuration (Optional - App works offline without these)
# To enable cloud sync, create a Firebase project at https://console.firebase.google.com
# Then: Add this Web app to your Firebase project, copy the config, and replace below

VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id-here

# Feature flag: set to "true" to enable user accounts and cloud sync.
# When "false" (default) or unset, the app runs in anonymous/offline mode
# and all data stays in localStorage. No Firebase calls are made.
VITE_ENABLE_AUTH=false

# Base URL for the Cloud Functions backend. Defaults to the local emulator
# URL (http://127.0.0.1:5001). In production, set this to the deployed
# functions URL (e.g., https://us-west1-your-project.cloudfunctions.net).
VITE_API_BASE_URL=http://127.0.0.1:5001

# Note: When Firebase is configured AND VITE_ENABLE_AUTH=true, your retirement
# plan will auto-sync to the cloud. All data remains privacy-safe - scoped to
# your authenticated user via Firestore security rules. You can still export/
# import JSON files anytime for offline backup.
