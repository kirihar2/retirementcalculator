# Firebase Configuration (Optional - App works offline without these)
# To enable cloud sync, create a Firebase project at https://console.firebase.google.com
# Then: Add this Web app to your Firebase project, copy the config, and replace below

VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id

# Note: When Firebase is configured, your retirement plan will auto-sync to the cloud
# All data remains privacy-safe - only stored values (no personal identifiers)
# You can still export/import JSON files anytime for offline backup
